<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="deviceClassBox">
    <property name="name">deviceClassGrid</property>
    <property name="valign">start</property>
    <property name="hexpand">1</property>
    <child>
      <object class="GtkLabel" id="labelDevice">
        <property name="name">labelDevice</property>
        <property name="hexpand">1</property>
        <property name="xalign">0</property>
      </object>
    </child>
    <child>
      <object class="GtkDropDown" id="cbDeviceClass">
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Disabled</item>
              <item translatable="yes">Mouse</item>
              <item translatable="yes">Pen</item>
              <item translatable="yes">Eraser</item>
              <item translatable="yes">Touchscreen</item>
            </items>
          </object>
        </property>
        <property name="name">cbDeviceClass</property>
        <property name="halign">end</property>
        <property name="selected">0</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="btnApply">
        <property name="label" translatable="1">Apply</property>
        <property name="focusable">1</property>
        <property name="receives-default">1</property>
      </object>
    </child>
  </object>
</interface>
